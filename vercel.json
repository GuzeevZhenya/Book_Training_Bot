{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "tsc --noEmit",
  "outputDirectory": "public",
  "installCommand": "npm install",
  "rewrites": [{ "source": "/", "destination": "/index.html" }],
  "functions": {
    "api/bot.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "src/**"
    }
  }
}
